# ─── Database ───────────────────────────────────────────
DATABASE_URL="your-pooled-database-url"
DIRECT_DATABASE_URL="your-direct-database-url"

# ─── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only: Supabase service role key. Keep secret; do NOT expose to client-side bundles.
# Used by backend API routes (e.g. /api/stats) for privileged queries.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Session Encryption ────────────────────────────────
SESSION_SECRET="generate-a-random-32-char-secret"
JWT_SECRET="generate-a-random-32-char-secret"

# ─── Blockchain ─────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID="84532"
NEXT_PUBLIC_CHAIN="base-sepolia"

NEXT_PUBLIC_FACTORY_ADDRESS="your-factory-address"
BASE_SEPOLIA_FACTORY_ADDRESS="your-factory-address"
# Display-only: homepage security section (ISO date)
NEXT_PUBLIC_FACTORY_DEPLOYED_AT="2026-05-28"
NEXT_PUBLIC_FOUNDRY_TESTS_URL="https://github.com/bhumistwt/PumpX-main/tree/main/contract"

NEXT_PUBLIC_ALCHEMY_API_KEY="your-alchemy-api-key"
ALCHEMY_API_KEY="your-alchemy-api-key"

NEXT_PUBLIC_RPC_URL="your-alchemy-rpc-url"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# ─── WalletConnect ──────────────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="your-walletconnect-project-id"

# ─── ML Service ─────────────────────────────────────────
ML_SERVICE_URL="http://localhost:8001"
ML_BLEND_WEIGHT="0.4"

# ─── AI ─────────────────────────────────────────────────
REDPILL_API_KEY="your-redpill-api-key"
# Used by /api/market-analysis for gpt-4o-mini (6h DB cache)
OPENAI_API_KEY="your-openai-api-key"

AI_API_URL="https://api.red-pill.ai/v1/chat/completions"
AI_MODEL="gpt-4o"

# ─── Stock Data ─────────────────────────────────────────
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key"
TWELVE_DATA_API_KEY="your-twelve-data-key"

# ─── Jobs / Operations ──────────────────────────────────
JOB_SECRET="generate-a-random-secret"
LOG_LEVEL="info"

FRAUD_LOW_CONF_THRESHOLD="0.3"
FRAUD_ABUSE_BET_COUNT="5"
FRAUD_ABUSE_WINDOW_MS="86400000"

RISK_BIG_ORDER_WEI="100000000000000000"
RISK_MANIPULATION_DEVIATION="0.25"
RISK_HIGH_DEVIATION_THRESHOLD="0.15"

SETTLE_ANOMALY_THRESHOLD="0.30"