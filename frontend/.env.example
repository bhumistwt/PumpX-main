# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/pumpx?schema=public"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/pumpx?schema=public"

# ─── Supabase (auth, storage, and backend services) ─────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Session Encryption ────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 16
SESSION_SECRET="change-me-to-a-random-32-char-secret"
JWT_SECRET="change-me-to-a-random-32-char-secret"

# ─── Blockchain ─────────────────────────────────────────
# "base" for production, "base-sepolia" for testnet
NEXT_PUBLIC_CHAIN_ID="84532"
NEXT_PUBLIC_CHAIN="base-sepolia"
NEXT_PUBLIC_FACTORY_ADDRESS="0x3b4774D45De4e271f857cAa7830Ee283bD7Bf544"
BASE_SEPOLIA_FACTORY_ADDRESS="0x3b4774D45De4e271f857cAa7830Ee283bD7Bf544"
BASE_MAINNET_FACTORY_ADDRESS=""
NEXT_PUBLIC_FACTORY_ADDRESS_BASE=""
NEXT_PUBLIC_ALCHEMY_API_KEY="your-alchemy-api-key"
ALCHEMY_API_KEY="your-alchemy-api-key"
NEXT_PUBLIC_RPC_URL=""
BASE_SEPOLIA_RPC_URL=""
BASE_MAINNET_RPC_URL=""
BASE_SEPOLIA_WS_URL=""
BASE_MAINNET_WS_URL=""

# ─── WalletConnect ──────────────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="your-walletconnect-project-id"

# ─── ML Service ─────────────────────────────────────────
ML_SERVICE_URL="http://localhost:8001"
ML_BLEND_WEIGHT="0.4"

# ─── AI (RedPill / OpenAI-compatible) ──────────────────
REDPILL_API_KEY="your-redpill-api-key"
OPENAI_API_KEY=""
AI_API_URL="https://api.red-pill.ai/v1/chat/completions"
AI_MODEL="gpt-4o"

# ─── Stock Data ─────────────────────────────────────────
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key"
TWELVE_DATA_API_KEY="your-twelve-data-key"

# ─── Redis (optional, for production rate limiting) ─────
# REDIS_URL="redis://localhost:6379"

# ─── Jobs / Operations ──────────────────────────────────
JOB_SECRET="your-job-secret"
LOG_LEVEL="info"
FRAUD_LOW_CONF_THRESHOLD="0.3"
FRAUD_ABUSE_BET_COUNT="5"
FRAUD_ABUSE_WINDOW_MS="86400000"
RISK_BIG_ORDER_WEI="100000000000000000"
RISK_MANIPULATION_DEVIATION="0.25"
RISK_HIGH_DEVIATION_THRESHOLD="0.15"
SETTLE_ANOMALY_THRESHOLD="0.30"

# ─── RPC Endpoints (optional overrides) ────────────────
# BASE_RPC_URL="https://mainnet.base.org"
# BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# ─── Legacy (deprecated — kept for reference) ──────────
# NEXT_PUBLIC_TOKEN_ARBRITRUM=
# NEXT_PUBLIC_FACTORY_ARBRITRUM=
# NEXT_PUBLIC_TOKEN_BASE=
# NEXT_PUBLIC_FACTORY_BASE=
# NEXT_PUBLIC_SUPABASE_URL=
